# RETIRED - do not deploy. The production app 'tenebris-c' is now
# served by the Rust server: deploy tenebris-rs/fly.toml instead (or
# the "Deploy server (Fly)" GitHub workflow). This file is kept only
# as the emergency rollback path to the C image:
#
#   fly deploy tenebris-c --config tenebris-c/fly.toml.retired
#
# fly.toml app configuration file generated for tenebris-c on 2026-05-10T22:25:49-05:00
#
# See https://fly.io/docs/reference/configuration/ for information about how to use this file.
#

app = 'tenebris-c'
primary_region = 'ord'

[http_service]
  internal_port = 8080
  force_https = true
  auto_stop_machines = 'stop'
  auto_start_machines = true
  min_machines_running = 0
  processes = ['app']

[[vm]]
  memory = '2gb'
  cpu_kind = 'shared'
  cpus = 1
  memory_mb = 2048

# Persistent volume so M6 chunk-diff saves survive every fly deploy.
# IMPORTANT: do NOT re-run `fly launch --copy-config` — it strips this
# block silently and saves stop persisting on the next redeploy.
[[mounts]]
  source      = "tenebris_saves"
  destination = "/data"
