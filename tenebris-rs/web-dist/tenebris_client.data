# Per-body atmosphere config.
#
# Loaded at boot by config_load_atmosphere() and applied to each
# matching body_config_t before the renderer reads it. Any field
# omitted falls back to the renderer default in main_web.c â€” set only
# what you want to override per planet.
#
# Sections are matched case-insensitively against body names (the
# `name` field in planet.c). Spaces in body names ("Asteroid A") get
# folded to underscores for the YAML key.
#
# Fields:
#   radius_mult         float  outer shell radius / planet radius
#   lower_radius_mult   float  atmosphere lower bound / planet radius
#                              (1.0 = atmosphere starts at the ground;
#                              >1.0 lifts the bottom up, thinning the
#                              shell; <1.0 sinks it under the surface.
#                              Also moves the planet-clip sphere used
#                              by the ray-march, so this is the knob
#                              for "how prominent is the limb halo".)
#   rayleigh_scale    float  main blue-sky knob, 1.0 = Earth
#   mie_scale         float  haze / forward sun-glow strength
#   sun_intensity     float  overall sky brightness multiplier
#   sunset_strength   float  warm-tint multiplier near horizon (0..1)
#   scale_height      float  density falloff in normalised altitude
#   mie_g             float  Mie phase asymmetry (-1..1)
#   wavelengths       vec3   (1/Î»â´) RGB ratios, RGB
#   sunset_tint       vec3   sky multiplier near horizon
#   sunset_glow       vec3   sun-direction glow at sunset
#   sunset_horizon    vec3   horizon-band tint at sunset

tenebris:
  # Outer shell at 1.6 Ã— planet radius â€” taller atmosphere column
  # so ground-level views have more sky overhead and orbital views
  # show a thicker atmosphere ring.
  radius_mult: 1.6
  # Sink the planet-clip sphere 10 % below the actual ground so the
  # atmosphere ray-march continues a bit past the visible horizon â€”
  # softens the harsh dark band where atmosphere meets the planet
  # silhouette in orbital views. Real terrain still occludes via
  # depth test so this only affects the band BEYOND the visible
  # terrain horizon.
  lower_radius_mult: 0.9
  # Aligned with Caelum's stated 'Tenebris default (scale-independent
  # with normalized steps)' values from src/atmosphere.c. Our shader
  # is now a faithful Caelum port (atmosphere.glsl), so the same
  # coefficients should produce the same look.
  sun_intensity: 9.0
  rayleigh_scale: 0.015
  mie_scale: 0.01
  mie_g: 0.85
  sunset_strength: 0.25
  scale_height: 0.25
  # Wavelengths + sunset vec3s are baked as literals in the new
  # Caelum-style atmosphere.glsl shader and ignored by the renderer
  # â€” kept here for back-compat in case we re-introduce per-body
  # tinting later.
  wavelengths: [5.602, 9.473, 19.644]
  sunset_tint: [1.3, 1.0, 0.6]
  sunset_glow: [1.0, 0.65, 0.25]
  sunset_horizon: [0.8, 0.4, 0.15]

# Sequoia â€” sister Earth-like, slightly greener tint.
sequoia:
  sun_intensity: 15.0
  rayleigh_scale: 0.8
  sunset_tint: [1.1, 1.3, 0.7]
  sunset_glow: [0.9, 1.0, 0.45]

# Add other has_water=true bodies here. Bodies without atmosphere
# (moons, asteroids, icy planets) ignore this file entirely.
# Terrain lighting tuning â€” drives the planet-aware day/night terminator
# in hex.glsl. Loaded at boot by config_load_lighting() and applied to
# every chunked terrain draw.
#
# Underwater terrain dimming is NOT tuned here â€” it reuses water.yaml's
# absorption + deep_color so the terrain visible under the cap reads
# continuously with the cap colour above it. Adjust those in water.yaml
# if you want the underwater look to change.
#
# Fields:
#   night_ambient_floor  float  Ambient brightness on the night side
#                               of the terminator, as a fraction of
#                               the full-day ambient. 0.10 = 10 % at
#                               midnight; 0.0 = pitch-black; 1.0 =
#                               no day/night cycle.
#   terminator_lo        float  Smoothstep lo edge on surface-dirÂ·sun
#                               (the dot product of the per-tile
#                               radial vector with the sun direction).
#                               Below this value the tile is fully
#                               shaded.
#   terminator_hi        float  Smoothstep hi edge. Above this value
#                               the tile is fully lit. The gap between
#                               lo and hi is the dawn/dusk band â€” the
#                               JS reference uses (-0.1, 0.3) which
#                               reads as a soft ~25Â° twilight zone
#                               straddling the geometric terminator.

#   torch_color          vec3   warm-tint multiplier for the additive
#                               torch contribution baked per-vertex
#                               on terrain. (1.0, 0.7, 0.3) = JS
#                               reference's wood-fire orange. Push
#                               red for embers, push white for a
#                               cleaner magic-glow.
#   torch_intensity      float  global scalar on top of torch_color.
#                               Lets designers dim/boost all torches
#                               without re-baking the per-vertex
#                               inverse-square sums.
#
#   engine               str    Per-vertex lighting backend.
#                               'column' = legacy path (sky_light_at
#                               counts solid voxels stacked above the
#                               column, torch_light_at sums inverse-
#                               square through walls). 'voxel' = new
#                               propagated grid in core/world_light:
#                               6-neighbour BFS with straight-down-
#                               through-air sky shafts + per-step
#                               attenuation. Defaults to 'column'
#                               for visual parity with previous builds.
#   voxel_sky_max        int    Max sky value seeded into open-sky air
#                               voxels before propagation. 15 matches
#                               the nibble range the mesher normalises
#                               against. Lower = darker daylight.
#   voxel_torch_emission int    Block light at each torch's anchor
#                               voxel before propagation. 14 leaves
#                               one step of headroom under the 15-cap;
#                               0 disables torch propagation entirely
#                               (useful when isolating sky tuning).

lighting:
  night_ambient_floor: 0.20
  terminator_lo:      -0.10
  terminator_hi:       0.30

  torch_color:         [1.00, 0.70, 0.30]
  torch_intensity:     1.00

  engine:               voxel
  voxel_sky_max:        15
  voxel_torch_emission: 14
  # Lateral BFS step attenuation. Vertical-down stays implicit -1
  # (preserves the daylight-shaft effect). 1 matches Minecraft's
  # behaviour: cavities and under-overhang interiors only darken
  # at the boundary, not several tiles into the open ground. Bump
  # to 2-3 if shadows feel too soft.
  voxel_sky_lateral_loss: 1
  # Per-frame BFS pop budget. Keeps a heavy relight from stalling
  # the frame after a chunk edit; the BFS resumes the following
  # frame from where it left off.
  voxel_rebuild_ops_per_frame: 50000
# Level-of-detail tuning for the renderer.
#
# Currently covers two things:
#   1. The distant-body icosphere â€” the cheap mesh the renderer swaps
#      in for any body whose angular size on screen drops below the
#      close-LOD threshold. Per-vertex colours are sampled from the
#      body's terrain (water hue when over an ocean, biome atlas
#      colour over land), then shaded by elevation and tinted by
#      tileset to give each planet its own colour grade from space.
#   2. Sphere-of-influence radius â€” the radius (in planet radii) at
#      which the player's "frame of reference" snaps to a given
#      body. Used by the per-frame SOI tracker so flying near a moon
#      hands the gravity / surface-basis / atmosphere shell to that
#      moon without needing an explicit teleport.
#
# Loaded at boot by config_load_lod(); fields default per
# core/config.c if omitted.
#
# Top-level fields:
#   distant_subdivisions    int    icosphere subdivision levels for far-LOD
#                                  bodies. 0 = 20 tris, 1 = 80, 2 = 320
#                                  (= 16Ã— the base icosa), 3 = 1280.
#                                  Higher = rounder distant-body
#                                  silhouette and a finer-grained
#                                  terrain-colour mosaic at the cost
#                                  of mesh build time + memory.
#   distant_shade_floor     float  vertex-colour multiplier at deepest
#                                  sampled altitude (-range_m below sea).
#                                  <1 darkens lowlands.
#   distant_shade_ceiling   float  vertex-colour multiplier at highest
#                                  sampled altitude (+range_m above sea).
#                                  >1 lightens peaks.
#   distant_shade_range_m   float  altitude in metres above/below sea
#                                  level that maps to the ceiling/floor
#                                  shade. Smaller = more dramatic
#                                  contrast over the same elevation.
#   gravity_full_mult       float  body radius multiplier inside which
#                                  gravity is at 100%. Default 1.4 =
#                                  full pull from the surface up to
#                                  40% of a planet radius above it.
#   gravity_falloff_mult    float  body radius multiplier at which
#                                  gravity has tapered to 0%. Outside
#                                  this radius the player is "in
#                                  space" and switches to 6DOF flight.
#                                  Default 1.8 (=80% above surface).
#   roll_slerp_duration_s   float  seconds the camera-roll-to-level
#                                  slerp runs after a space â†’ planet
#                                  transition. Default 3.0.
#   roll_slerp_speed        float  per-second exponential approach
#                                  factor for the slerp; lower =
#                                  smoother / slower. Default 0.8.
#   space_thrust            float  m/sÂ² of acceleration while a
#                                  movement key is held in space.
#   space_drag              float  per-second damping coefficient on
#                                  the space velocity vector.
#   space_roll_speed        float  rad/s for Q/E roll keys in space.
#
# Per-tileset palette sections (earth / sequoia / crag / frost /
# asteroid). Each may set:
#   water_color         vec3   open-ocean colour the distant LOD reads
#                              when sampling a tile whose column has a
#                              water layer above the topmost solid
#                              block. Mixed with the seabed atlas
#                              colour by water-column thickness so
#                              shorelines stay sandy.
#   lowland_tint        vec3   colour multiplier at -shade_range_m
#                              altitude. Combines with distant_shade
#                              to colour-grade basins per tileset.
#   peak_tint           vec3   colour multiplier at +shade_range_m.
#                              Same treatment for ridges / peaks.
#   water_full_depth_m  float  water-column thickness at which
#                              water_color fully dominates the seabed.
#                              Below this the shore reads sandy /
#                              muddy; above it the open ocean reads
#                              pure water hue.

lod:
  distant_subdivisions:   2
  distant_shade_floor:    0.65
  distant_shade_ceiling:  1.20
  distant_shade_range_m:  50.0
  gravity_full_mult:      1.4
  gravity_falloff_mult:   1.8
  roll_slerp_duration_s:  3.0
  roll_slerp_speed:       0.8
  space_thrust:           15.0
  space_drag:             1.21
  space_roll_speed:       2.0
  # Tap-to-jump vs hold-for-jetpack discrimination. A jump press is
  # treated as a tap (one strong impulse, scaled by jump_velocity_mps)
  # when released within jetpack_hold_threshold_s seconds; holding
  # past the threshold continuously fires the jetpack at
  # jetpack_accel_mps2 up to jetpack_max_vy_mps terminal velocity.
  jump_velocity_mps:           12.0
  jetpack_hold_threshold_s:    0.5
  jetpack_accel_mps2:          42.0
  jetpack_max_vy_mps:          14.0

  # Player capsule. height_m is foot-to-head distance - the ceiling
  # collision rejects any tile whose first overhead solid block sits
  # within feet + height_m. Set this to match EYE_HEIGHT plus a bit
  # of head clearance.
  player_height_m:             1.8

  # Maximum vertical step-up in one frame. Used both for horizontal
  # step-on-curb (walking into a tile whose floor sits this much above
  # current feet) AND for ground-snap pop-up (bridge case, or feet
  # below a near floor). Larger = climb taller steps without jumping,
  # but more risk of popping to the top of a tall column after a fall.
  # 0.6 is the historical "auto-step half a block" feel.
  step_height_m:               0.6

  # Camera-cylinder collider radius. The eye sits EYE_HEIGHT above the
  # player's feet; when it gets closer than this to a solid voxel face
  # at eye depth, the player is pushed back so the near plane doesn't
  # clip through the wall. Must be >= 0.3 m (the perspective near
  # plane) with some margin. Set to 0 to disable.
  camera_collider_radius_m:    0.5

  # Water physics. The player has three "water" gates:
  #   - feet in water  (feet_radius is inside a water voxel)
  #   - body in water  (feet + water_body_check_height_m is in water)
  #   - eyes in water  (feet + EYE_HEIGHT is in water)
  # Slow movement + reduced gravity + drag apply while the body is
  # submerged; the swim jump model engages once the eyes go under.
  water_gravity_mult:           0.30
  water_drag_per_s:             3.0
  water_movement_mult:          0.50
  water_swim_force_mps2:        20.0
  water_surface_float_height_m: -0.8
  water_body_check_height_m:    0.50
  water_submerged_jump_mult:    0.30

earth:
  water_color:        [0.10, 0.28, 0.55]
  lowland_tint:       [0.85, 0.80, 0.65]
  peak_tint:          [1.05, 1.05, 1.10]
  water_full_depth_m: 4.0

sequoia:
  water_color:        [0.16, 0.42, 0.34]
  lowland_tint:       [0.75, 0.85, 0.55]
  peak_tint:          [1.00, 0.95, 0.80]
  water_full_depth_m: 4.0
  # Close-up water gets a saturated alien-green tint via Beer-Lambert.
  # absorption tuned so red AND blue die fast with thickness, leaving
  # green to dominate; deep_color is the saturation tint at infinite
  # depth. Leave both at [0,0,0] to fall back to the global blue water.
  water_deep_color:   [0.04, 0.20, 0.10]
  water_absorption:   [0.50, 0.10, 0.50]

crag:
  water_color:        [0.55, 0.30, 0.18]
  lowland_tint:       [0.95, 0.55, 0.35]
  peak_tint:          [0.70, 0.45, 0.35]
  water_full_depth_m: 4.0

frost:
  water_color:        [0.45, 0.65, 0.85]
  lowland_tint:       [0.85, 0.95, 1.00]
  peak_tint:          [1.10, 1.15, 1.20]
  water_full_depth_m: 4.0

asteroid:
  water_color:        [0.20, 0.20, 0.22]
  lowland_tint:       [0.60, 0.55, 0.50]
  peak_tint:          [0.75, 0.72, 0.70]
  water_full_depth_m: 4.0
# Global skybox tuning: 3-layer Voronoi starfield + fbm nebula +
# deep-space backdrop. Read each frame by renderer_draw_skybox and
# uploaded to FS_SKY as uniforms.
#
# Loaded at boot by config_load_skybox(). Anything omitted falls back
# to the compiled-in default in core/config.c â€” set only what you want
# to override.
#
# Fields (all optional):
#   star_densities             vec3   per-layer cell density (cells per
#                                     unit-sphere chunk). Higher = more,
#                                     smaller stars. Default [100, 200, 300].
#   star_intensities           vec3   per-layer brightness weights. Default
#                                     [1.0, 0.8, 0.6].
#   star_sharpness             float  smoothstep upper bound on squared
#                                     cell-distance â€” smaller = tighter
#                                     points. Default 0.02.
#   star_brightness_threshold  float  cells dimmer than this stay dark.
#                                     Higher = sparser sky. Default 0.7.
#   star_color                 vec3   RGB tint applied to all stars.
#
#   nebula_warm_color          vec3   warm-tint colour (magenta-rose).
#   nebula_cool_color          vec3   cool-tint colour (deep blue).
#   nebula_intensity           float  overall nebula opacity multiplier.
#                                     Default 0.20. 0 = no nebula at all.
#   nebula_drift_speed         float  time-based drift rate (rad/sec-ish).
#                                     Default 0.005 â€” barely-moving wash.
#   nebula_scale1              float  fbm sampling scale for cloud cover.
#                                     Bigger = finer-grained clouds.
#   nebula_scale2              float  fbm sampling scale for warm/cool mix.
#   nebula_cloud_lo, _hi       float  smoothstep window over cloud fbm â€”
#                                     gates where clouds appear at all.
#   nebula_warm_blend_lo, _hi  float  smoothstep window over the second
#                                     fbm â€” drives the warm/cool blend.
#
#   space_color                vec3   RGB added under everything. Not
#                                     pure black by default; a touch of
#                                     cool blue keeps the void from
#                                     looking dead.

skybox:
  star_densities:            [100.0, 200.0, 300.0]
  star_intensities:          [1.0, 0.8, 0.6]
  star_sharpness:            0.02
  star_brightness_threshold: 0.7
  star_color:                [1.0, 0.98, 0.95]

  nebula_warm_color:         [0.55, 0.18, 0.38]
  nebula_cool_color:         [0.10, 0.20, 0.50]
  nebula_intensity:          0.20
  nebula_drift_speed:        0.005
  nebula_scale1:             1.4
  nebula_scale2:             3.1
  nebula_cloud_lo:           0.45
  nebula_cloud_hi:           0.78
  nebula_warm_blend_lo:      0.3
  nebula_warm_blend_hi:      0.8

  space_color:               [0.005, 0.007, 0.018]
# Water surface + refraction tuning.
#
# Loaded at boot by config_load_water() and applied to body_draw_water
# every frame + read once at mesh-build time by hex_mesher.c for the
# cap depth offset. Single global config â€” the same knobs apply to
# every has_water body.
#
# Fields:
#   time_scale          float  multiplier on R.time_seconds before it
#                              reaches u_time. Higher = faster ripples.
#   depth_offset_m      float  vertical drop of the cap below sea
#                              level (metres). Has to exceed the max
#                              swell or wave crests poke above sand.
#   height_offset_m     float  creative water-level offset, additive
#                              on top of depth_offset_m. Positive
#                              raises the cap (water deeper / floods
#                              further inland), negative lowers it.
#                              0.0 = current sea level.
#   refract_amount      float  surface gradient â†’ screen UV
#                              perturbation scale. 0 = no refraction,
#                              ~0.04 = noticeable shimmer without
#                              warping the view.
#   absorption          vec3   Beer-Lambert sigma per RGB channel
#                              (1/m). Higher = water saturates
#                              faster. Real ocean has red ~6Ã— blue.
#   deep_color          vec3   saturation tint where view ray has
#                              fully attenuated. Limit colour of
#                              deep water.
#   shoreline_fade_m    float  alpha smoothstep upper edge (m).
#                              At thickness 0 the cap goes
#                              transparent, by this much water it's
#                              back to the Fresnel-driven alpha.
#                              Hides the hex-mesh edge at the beach.
#   specular_intensity  float  sun-highlight strength multiplier.
#                              Higher = brighter glints / glossier;
#                              lower = matte.
#   specular_power      float  Blinn-Phong specular exponent.
#                              Higher = tighter / smaller highlight,
#                              lower = broader / softer.
#   sun_tint            vec3   warm tint of the sun-highlight,
#                              multiplied with specular_intensity.
#                              >1.0 in any channel pushes brighter
#                              than white.
#
#   --- Wave-crest + slope foam (the bright flecks across the wave
#   surface). Two smoothstep ranges feed a max() blend with per-
#   source weights; the combined mass tints toward foam_color at
#   foam_intensity. Raise foam_crest_lo to ~0.55 if open water has
#   too many flecks.
#   foam_crest_lo       float  smoothstep lo on fbm height [-1, +1]
#   foam_crest_hi       float  smoothstep hi
#   foam_crest_weight   float  weight in max(crest, slope) blend
#   foam_slope_lo       float  smoothstep lo on |tangent gradient|
#   foam_slope_hi       float  smoothstep hi
#   foam_slope_weight   float
#   foam_intensity      float  final mix strength toward foam_color
#   foam_color          vec3
#
#   --- Sky reflection. Water reflects the upper hemisphere via
#   reflect(view, n); the result blends between two tones based on
#   the reflected ray's vertical component.
#   sky_horizon_color   vec3   bright tone, reflected ray ~horizontal
#   sky_zenith_color    vec3   darker tone, reflected ray ~vertical
#   sky_horizon_strength float opacity of the horizon-direction sky
#                              reflection on the final water colour.
#                              Scales the Fresnel skyâ†’base blend
#                              factor, but only where the reflected
#                              ray skims horizontal â€” zenith-direction
#                              reflections are unaffected at any
#                              value. 1.0 = unchanged Fresnel mix,
#                              0.0 = horizon reflection disappears
#                              entirely (water shows the refracted /
#                              deep colour even at glancing angles).
#
#   --- Wave shape. Two independent stages:
#     * Swell  â€” vertex-shader sine sum, displaces the cap mesh.
#                Geometric height of the waves; visible silhouette.
#     * Ripple â€” fragment-shader fbm noise, perturbs the surface
#                normal. Drives where the highlights and refraction
#                go without changing the geometry.
#   swell_amplitude     float  vertex-displacement multiplier (wave
#                              height). 1.0 keeps the historical
#                              0.36 m peak; >~1.39 starts poking
#                              crests through depth_offset_m into
#                              beach geometry.
#   swell_frequency     float  spatial-frequency multiplier on the
#                              sine swell. Higher = shorter wavelength
#                              (more, smaller waves).
#   swell_speed         float  time multiplier on the sine swell
#                              (animation speed). Stacks with
#                              time_scale.
#   ripple_scale        float  spatial multiplier inside the fbm
#                              normal noise. Higher = finer / busier
#                              ripple cells; gradient sharpens too,
#                              so the surface looks bumpier unless
#                              you also drop wave_steepness.
#   ripple_speed        float  time-advection multiplier inside fbm.
#                              Stacks with time_scale.
#   wave_steepness      float  magnitude with which the tangent
#                              gradient perturbs the radial normal.
#                              Higher = choppier-looking surface;
#                              0.0 = perfect mirror sphere. Replaces
#                              the historical 0.65 literal.

water:
  time_scale:         0.75
  depth_offset_m:     0.50
  height_offset_m:    0.00
  refract_amount:     0.04
  absorption:         [0.60, 0.20, 0.10]
  deep_color:         [0.02, 0.10, 0.22]
  shoreline_fade_m:   0.50
  specular_intensity: 0.30
  specular_power:     140.0
  sun_tint:           [1.35, 1.25, 1.10]

  foam_crest_lo:      0.35
  foam_crest_hi:      0.60
  foam_crest_weight:  0.55
  foam_slope_lo:      0.50
  foam_slope_hi:      1.20
  foam_slope_weight:  0.26
  foam_intensity:     0.10
  foam_color:         [0.95, 0.97, 1.00]

  sky_horizon_color:    [0.85, 0.92, 0.98]
  sky_zenith_color:     [0.35, 0.55, 0.85]
  sky_horizon_strength: 0.5

  swell_amplitude:    0.5
  swell_frequency:    2.0
  swell_speed:        1.0
  ripple_scale:       1.5
  ripple_speed:       1.0
  wave_steepness:     0.65

  # ---- Underwater post-process (fires when the camera is below sea
  # level; per-pixel masked so a half-submerged camera leaves dry-side
  # pixels untouched).
  #
  # The fog itself reuses the same Beer-Lambert formula the water cap
  # uses when looking down through water from above (absorption +
  # deep_color above), so above-water and below-water views read as
  # the same body of water. Only the screen-space distortion has its
  # own knob â€” it has no above-water analogue.
  #
  # underwater_distortion  float  amplitude (in screen-UV units) of the
  #                               sin-perturbation applied to the scene
  #                               sample on underwater pixels. ~0.005
  #                               is a subtle shimmer; 0.0 disables it.
  # wet_fade_band_m        float  soft fade either side of the actual
  #                               water-cap altitude (m) where the
  #                               composite gates the wet mask. Wider =
  #                               longer crossfade across the waterline;
  #                               keeps dry portions of beach blocks
  #                               (whose tops sit above the cap by
  #                               depth_offset_m) from picking up the
  #                               distortion shimmer.
  underwater_distortion:   0.0015
  wet_fade_band_m:         0.5

  # Mobile-only horizon haze. The mobile water shader can't sample the
  # offscreen scene (no FBO on phones), so it can't reproduce the
  # desktop Beer-Lambert thickness fog. Instead it blends the base
  # tone toward sky_horizon_color with view distance, faking the
  # "deep ocean fades into atmosphere" feel.
  #
  # horizon_fade_m         float  view-distance (m) at which the haze
  #                               saturates. Closer = haze kicks in
  #                               faster (busier-looking water in the
  #                               middle distance), farther = surface
  #                               stays the deep colour for longer.
  # horizon_fade_strength  float  final mix scalar. 0 disables the
  #                               effect (mobile reads like a flat
  #                               slab again); 1 fully replaces deep
  #                               colour with sky_horizon at fade_m.
  horizon_fade_m:          600.0
  horizon_fade_strength:   0.55

  # ---- Per-voxel water-flow automaton (water_flow_config_t).
  # Separate from everything above - those knobs tune the planet-wide
  # sea-level cap (shader / mesh); the ones below tune the cellular
  # water in core/world_water.c, which moves around and reacts to edits.
  # See tenebris-c/water.md for the full plan / algorithm.
  #
  # flow_max_level           int   max flowing level before drying up.
  #                                Capped at 7 by the 3-bit state field
  #                                regardless of YAML value; lower = shorter
  #                                streams. 7 matches Minecraft's 8-step
  #                                ladder; we run tighter (3) so a single
  #                                placed source forms a small puddle
  #                                rather than flooding the surrounding
  #                                terrain a 7-hex radius out.
  # flow_search_radius       int   BFS depth (hex steps) used by the
  #                                nearest-hole pathfinder when picking
  #                                horizontal spread direction. 4 matches MC -
  #                                kept slightly above flow_max_level so water
  #                                routes toward a drop one step beyond its
  #                                own dry-up range instead of pooling blindly.
  # flow_ticks_per_step      int   sim ticks between scheduler calls. 5
  #                                matches MC's "5 game ticks per block".
  # flow_max_ticks_per_step  int   per-call cap on cells popped from the
  #                                queue. Bounds per-frame cost when a big
  #                                body of water re-converges.
  # flow_queue_capacity      int   ring-buffer size (cells). Overflow drops
  #                                the oldest pending tick; the world re-
  #                                converges as soon as something adjacent
  #                                wakes the dropped cell again.
  # flow_source_min_nbrs     int   2-of-N threshold for flowing -> source
  #                                promotion. 2 = MC behaviour (renewable
  #                                water from a 3-tile triangle on hex);
  #                                3 = pentagons need a fuller basin.
  # flow_persist_falling     int   0 = falling cells reconstruct from
  #                                neighbours on reload (cheap I/O), 1 =
  #                                falling cells round-trip to disk on
  #                                every tick (no reload transient).
  #
  # ---- Visual / rendering knobs - read by the mesher (step 6) and
  # shader (step 7). Defined here so simulation + look stay in one file.
  #
  # flow_uv_speed_falling    float V scroll speed on falling side faces
  #                                (units / sec). Positive moves texels
  #                                radially inward (down).
  # flow_uv_speed_per_level  float cap UV scroll speed per level-diff
  #                                between this cell and its lowest
  #                                horizontal neighbour.
  # flow_min_film_fraction   float min cap height as fraction of voxel
  #                                height. Keeps the thinnest film visible
  #                                instead of going to zero.
  # flow_cap_curve_power     float exponent on (level / max_level) when mapping
  #                                a flowing cell's level to its cap height.
  #                                1.0 = linear (constant drop per step;
  #                                visually "piles up" because near-source
  #                                cells render near full height), 2.0 =
  #                                quadratic (each step drops more than the
  #                                last - water reads as accelerating downward
  #                                as it travels further from the source),
  #                                higher = even more aggressive falloff.
  # 3 hexes of horizontal spread per source (default 3 = stronger
  # falloff than MC's 7). With the hex topology + 6-way spread, a
  # single source already reaches 19 cells at radius 2 and 37 at
  # radius 3, so dropping the cap below 7 keeps placement intuitive
  # without flooding the whole world. Raise toward 7 for MC-style
  # long streams, lower toward 2 for puddles only.
  flow_max_level:           3
  flow_search_radius:       4
  # Halved the tick rate (was 5 = 4 Hz, now 10 = 2 Hz) so flow
  # propagation paces out visibly instead of finishing inside the
  # render-stall window. Each "spread step" now takes 500 ms which
  # also halves the worst-case relight + remesh cost per simulated
  # second.
  flow_ticks_per_step:      10
  flow_max_ticks_per_step:  256
  flow_queue_capacity:      4096
  flow_source_min_nbrs:     2
  flow_persist_falling:     0

  # ---- Mesh rebuild budget. The renderer rebuilds a chunk's whole mesh
  # (terrain + water + per-voxel water) when ANY tile in the chunk goes
  # dirty. A busy water flow tick can dirty tiles across multiple chunks
  # at once, and rebuilding all of them in the same frame stalls the
  # mainloop visibly. This knob caps how many chunks each body remeshes
  # per frame - extra dirty chunks stay dirty and roll over to the next
  # frame, spreading the cost without losing any work. 1 = strictly one
  # chunk per body per frame (smoothest framerate), higher = less latency
  # to converge but more frametime variance during heavy flow.
  # 1 chunk per frame meant a single sim tick that dirtied 12 chunks
  # (water cascading across a hillside hits ~that many at once) took
  # 12 frames to fully converge, and the chunks waiting in queue
  # rendered with their PREVIOUS mesh - visible as "stale walls
  # poking up from the water" until each chunk's turn rolled around.
  # 8 chunks per frame drains a 12-chunk dirty batch in 2 frames
  # (~33 ms at 60 fps) which is well below human-noticeable lag,
  # while still capping the worst-case frametime impact of a flood.
  flow_max_chunks_remesh_per_frame: 8

  flow_uv_speed_falling:    1.0
  flow_uv_speed_per_level:  0.25
  flow_min_film_fraction:   0.12
  # Power < 1 puts the BIGGEST cap drop into the very first level step
  # (source -> first ring), so the bell visibly steps down by one
  # voxel-fraction at every hex ring instead of bunching levels 0 + 1
  # near the same height. Was 2.0, which made the first step almost
  # invisible and the bell read as 2-hex-wide rungs. 0.5 puts ~half
  # the depth_offset drop into the first step alone, tightening the
  # bell to one-ring-per-step.
  flow_cap_curve_power:     0.5
‰PNG

