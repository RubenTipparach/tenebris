# WASM / CMake build products
tenebris-c/build-*/

# Python bytecode caches from the tools/ generators
tenebris-c/tools/__pycache__/

# Staged runtime assets for tenebris-c. The atlas PNGs get copied
# from ../public/textures/ by the CMake step, so they're regenerated
# on every fresh checkout - no need to track them. The water normal
# map is the exception: it's procedurally generated by
# tenebris-c/tools/gen-water-normal.py and committed so a fresh
# checkout doesn't need Python at build time.
tenebris-c/assets/textures/*.png
!tenebris-c/assets/textures/water_normal.png
!tenebris-c/assets/textures/water_flow_arrow.png
tenebris-c/assets/textures/planet_seq/
